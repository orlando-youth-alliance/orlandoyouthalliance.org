---
permalink: /404.html
eleventyExcludeFromCollections: true
title: Page Not Found
---
<!DOCTYPE html>
<html lang="en" style="visibility:hidden">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Page Not Found | {{ chapter.name }}</title>
    <link rel="stylesheet" href="/assets/styles/index.css">

    <script>
      // Legacy URL redirects — run before page renders to avoid a flash
      (function () {
        // GitHub Pages (and the local dev server) only ever serve one
        // 404.html for the whole site, at the root — never a chapter
        // sub-path's own copy. So this single script has to work out which
        // chapter it's running under from the URL itself, not from a prefix
        // baked in at build time.
        var params = new URLSearchParams(window.location.search);
        var path = window.location.pathname;
        var prefix = '/';
        var chapterMatch = path.match(/^\/(seminole|lakeland|osceola)\//i);
        if (chapterMatch) {
          prefix = '/' + chapterMatch[1].toLowerCase() + '/';
          path = '/' + path.slice(prefix.length);
        }

        // Legacy CMS used /ContentPage and /ContentPage.aspx interchangeably
        if (/^\/contentpage(\.aspx)?\/?$/i.test(path)) {
          var map = {
            '1':  'mission/',
            '2':  'youth/',
            '3':  'parents/',
            '4':  'volunteer/',
            '8':  'donate/',
            '9':  'contact/',
            '19': 'grants/',
            '27': 'calendar/',
            '31': 'about/',
            '32': 'partners/',
            '34': ''
          };
          var dest = map[params.get('id')];
          window.location.replace(prefix + (dest !== undefined ? dest : '')); return;
        }

        // Calendar.aspx → calendar/
        if (/calendar\.aspx/i.test(path)) {
          window.location.replace(prefix + 'calendar/'); return;
        }

        // Legacy CMS also indexed a /Locations page — no equivalent, send home
        if (/^\/locations\/?$/i.test(path)) {
          window.location.replace(prefix); return;
        }

        // Legacy capitalized paths (e.g. /Mission/) → lowercase equivalent,
        // within this build's prefix
        var lower = path.toLowerCase();
        if (lower !== path) {
          var known = ['about', 'bequests', 'board', 'calendar', 'celebrity-server', 'contact', 'counselors', 'donate', 'grants', 'join', 'mission', 'newsletters', 'parents', 'partners', 'resources', 'scholarships', 'volunteer', 'youth'];
          var slug = lower.replace(/^\/|\/$/g, '');
          if (known.indexOf(slug) !== -1) {
            window.location.replace(prefix + slug + '/'); return;
          }
        }

        // Not a known legacy URL — show the 404 page
        document.documentElement.style.visibility = 'visible';
      })();
    </script>

    <!-- prevents flashing during dark/light mode switching -->
    <script src="/assets/js/theme.js"></script>
  </head>

  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 font-sans">

    {% include "partials/header.njk" %}

    <main class="flex-1 max-w-4xl w-full mx-auto px-4 my-10 text-center prose dark:prose-invert">
      <h1 class="font-medium">Page Not Found</h1>
      <p>Sorry, the page you're looking for doesn't exist or may have moved.</p>
      <p><a href="/">Return to the homepage &rarr;</a></p>
    </main>

    {% include "partials/footer.njk" %}

  </body>
</html>
